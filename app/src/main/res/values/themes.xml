<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PlayLux" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/lux_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- SplashScreen API Theme -->
    <style name="Theme.PlayLux.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lux_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_playlux_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.PlayLux</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Backwards compatible alias -->
    <style name="Theme.MyApplication" parent="Theme.PlayLux" />
</resources>
